<Project Sdk="Microsoft.NET.Sdk">
  <!-- Al forretningslogik til Windows-versionen: database, sortering, naboer, søgning, Discogs, iMusic.
       Ingen brugerflade, så den kan bygges og tjekkes på alle platforme (også i CI på Linux). -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>VinylShelfFinder.Core</RootNamespace>
    <AssemblyName>VinylCore</AssemblyName>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.10" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="VinylCore.Checks" />
  </ItemGroup>
</Project>
