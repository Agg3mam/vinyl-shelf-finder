<Project Sdk="Microsoft.NET.Sdk">
  <!-- Windows-appen (WinUI 3, uden MSIX-pakke). Bygges kun på Windows (se .github/workflows/windows.yml).
       Udgives som én mappe, der kører på en ren Windows 10/11 uden at installere noget:
       .NET og Windows App SDK ligger begge i mappen (SelfContained + WindowsAppSDKSelfContained). -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <RootNamespace>VinylShelfFinder</RootNamespace>
    <AssemblyName>VinylShelfFinder</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <PublishReadyToRun>false</PublishReadyToRun>
    <PublishTrimmed>false</PublishTrimmed>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <DefaultLanguage>da-DK</DefaultLanguage>
    <SatelliteResourceLanguages>da;en</SatelliteResourceLanguages>
    <Product>Vinyl Shelf Finder</Product>
    <!-- Samme udgangspunkt som Mac (Info.plist). Ved et tag v* sætter windows.yml -p:Version= fra tagget. -->
    <Version>0.1.0</Version>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <AssemblyTitle>Vinyl Shelf Finder</AssemblyTitle>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.6.250205002" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.1742" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\VinylCore\VinylCore.csproj" />
  </ItemGroup>
</Project>
