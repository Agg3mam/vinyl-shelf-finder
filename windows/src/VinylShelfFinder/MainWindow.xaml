<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="VinylShelfFinder.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Vinyl Shelf Finder">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <!-- Skærmene bygges i kode (MainWindow.xaml.cs og Views/), som på Mac. -->
    <Grid x:Name="Root" Language="da-DK">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Ny version / status for opdatering (styres af Updater). -->
        <InfoBar x:Name="UpdateBar" Grid.Row="0" IsOpen="False" IsClosable="True" Margin="12,8,12,0"
                 CloseButtonClick="UpdateBar_CloseButtonClick">
            <InfoBar.Content>
                <StackPanel x:Name="UpdateButtons" Orientation="Horizontal" Spacing="8" Margin="0,0,0,12">
                    <Button x:Name="UpdateNowButton" Content="Opdatér nu" Style="{StaticResource AccentButtonStyle}" Click="UpdateNow_Click" />
                    <Button x:Name="UpdateLaterButton" Content="Senere" Click="UpdateLater_Click" />
                    <Button x:Name="UpdateCheckButton" Content="Søg efter opdatering" Click="UpdateCheck_Click" />
                </StackPanel>
            </InfoBar.Content>
        </InfoBar>

        <NavigationView x:Name="Nav" Grid.Row="1"
                        PaneDisplayMode="Left"
                        IsSettingsVisible="True"
                        IsBackButtonVisible="Collapsed"
                        OpenPaneLength="260"
                        SelectionChanged="Nav_SelectionChanged"
                        ItemInvoked="Nav_ItemInvoked">
            <Grid x:Name="Body">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="ListColumn" Width="420" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid x:Name="TopBar" Grid.ColumnSpan="2" />
                <Border x:Name="ListHost" Grid.Row="1" Grid.Column="0"
                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,1,0" />
                <Border x:Name="DetailHost" Grid.Row="1" Grid.Column="1" />
                <Border x:Name="FullHost" Grid.Row="1" Grid.ColumnSpan="2" Visibility="Collapsed" />
            </Grid>
        </NavigationView>

        <!-- Find i reolen / Sæt tilbage: et lag over hele vinduet. -->
        <Border x:Name="OverlayHost" Grid.RowSpan="2" />
    </Grid>
</Window>
