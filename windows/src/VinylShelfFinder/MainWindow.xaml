<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="VinylShelfFinder.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Vinyl Shelf Finder">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="Root" Language="da-DK">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Ny version / status for opdatering (styres af Updater i MainWindow.xaml.cs). -->
        <InfoBar x:Name="UpdateBar" Grid.Row="0" IsOpen="False" IsClosable="True" Margin="12,8,12,0"
                 CloseButtonClick="UpdateBar_CloseButtonClick">
            <InfoBar.Content>
                <StackPanel x:Name="UpdateButtons" Orientation="Horizontal" Spacing="8" Margin="0,0,0,12">
                    <Button x:Name="UpdateNowButton" Content="Opdatér nu" Style="{StaticResource AccentButtonStyle}" Click="UpdateNow_Click" />
                    <Button x:Name="UpdateLaterButton" Content="Senere" Click="UpdateLater_Click" />
                    <Button x:Name="UpdateCheckButton" Content="Søg efter opdatering" Click="UpdateCheck_Click" />
                </StackPanel>
            </InfoBar.Content>
        </InfoBar>

        <NavigationView x:Name="Nav" Grid.Row="1"
                        PaneDisplayMode="Left"
                        IsSettingsVisible="False"
                        IsBackButtonVisible="Collapsed"
                        OpenPaneLength="260"
                        SelectionChanged="Nav_SelectionChanged"
                        ItemInvoked="Nav_ItemInvoked">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="Søg" Tag="search">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE721;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItemHeader Content="Sektioner" />
                <NavigationViewItem Content="Nye plader" Tag="new">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE710;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Fjernet fra Discogs" Tag="removed">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE74D;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Ude af reolen" Tag="out">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE8F1;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Historik" Tag="history">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE81C;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Værdi" Tag="value">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE8EF;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Hvad skal jeg høre?" Tag="suggest">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE8D6;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Lyttelog" Tag="listenlog">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE8FD;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Find nye plader" Tag="discover">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE719;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <NavigationView.FooterMenuItems>
                <NavigationViewItem x:Name="UpdateItem" Content="Opdatering" Tag="update" SelectsOnInvoked="False">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE895;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <Frame x:Name="ContentFrame" />
        </NavigationView>
    </Grid>
</Window>
